<form class="fatex-desk fatex-scene-aspects">
    <header class="fatex-header">
        <div class="fatex-header__name">
            <label class="fatex-header__label">{{localize "FAx.Global.SceneAspects"}}</label>
            <div class="fatex-header__title">{{localize "FAx.Global.ManageAspects"}}</div>
        </div>
        <div class="fatex-header__actions">
            <button type="button" class="place-on-canvas" title="{{localize 'FAx.Manager.PlacePanel'}}"><i class="fas fa-map-pin"></i></button>
            <button type="button" class="manage-tags" title="{{localize 'FAx.Global.ManageTags'}}"><i class="fas fa-tags"></i> {{localize 'FAx.Global.Tags'}}</button>
            <button type="button" class="create-group" title="{{localize 'FAx.Global.CreateGroup'}}"><i class="fas fa-folder-plus"></i> {{localize 'FAx.Global.Category'}}</button>
        </div>
    </header>

    <div class="fatex-toolbar">
        <input type="text" class="fatex-search" placeholder="{{localize 'FAx.Global.SearchAspects'}}">
        <div class="fatex-toolbar-actions">
            <button type="button" class="collapse-all" title="{{localize 'FAx.Global.CollapseAll'}}"><i class="fas fa-chevron-up"></i></button>
            <button type="button" class="expand-all" title="{{localize 'FAx.Global.ExpandAll'}}"><i class="fas fa-chevron-down"></i></button>
        </div>
    </div>

    <div class="fatex-desk__content">
        {{#if groups.length}}
            <div class="fatex-desk__aspects">
            {{#each groups}}
            <div class="fatex-aspect-group {{#if this.hidden}}is-hidden{{/if}}" data-group-id="{{this.id}}">
                <header class="fatex-group-header" draggable="true" data-group-id="{{this.id}}" title="{{localize 'FAx.Global.DragToScene'}}">
                    <i class="fas {{#if this.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} group-collapse" data-group-id="{{this.id}}" title="{{#if this.collapsed}}{{localize 'FAx.Global.Expand'}}{{else}}{{localize 'FAx.Global.Collapse'}}{{/if}}"></i>
                    <input type="text" class="group-label" value="{{this.label}}" data-group-id="{{this.id}}" />
                    <div class="group-actions">
                        {{#if ../isGM}}
                        <i class="fas {{#if this.hidden}}fa-eye-slash{{else}}fa-eye{{/if}} group-visibility" data-group-id="{{this.id}}" title="{{localize 'FAx.Global.ToggleVisibility'}}"></i>
                        {{/if}}
                        <i class="fas fa-plus create-aspect" data-group-id="{{this.id}}" title="{{localize 'FAx.Global.Add'}}"></i>
                        <i class="fas fa-trash group-delete" data-group-id="{{this.id}}" title="{{localize 'FAx.Global.DeleteCategory'}}"></i>
                    </div>
                </header>


                <div class="fatex-group-content {{#if this.collapsed}}is-collapsed{{/if}}">
                    {{#each this.aspects}}
                    <div class="fatex-item fatex-scene-aspect {{#if this.hidden}}is-hidden{{/if}}" data-id="{{this.id}}" style="border-left: 6px solid {{this.color}}; position:relative;" title="{{localize 'FAx.Global.DragToScene'}}">
                        <input type="color" class="aspect-color-trigger" value="{{this.color}}" data-id="{{this.id}}" data-field="color" title="{{localize 'FAx.Global.Color'}}" style="position:absolute; top:0; left:-6px; width:6px; height:100%; opacity:0; cursor:pointer; z-index:10; border:none; padding:0; margin:0;" onmousedown="event.stopPropagation()" ondragstart="event.preventDefault(); event.stopPropagation(); return false;" onpointerdown="event.stopPropagation()" onpointerdown="event.stopPropagation()">
                        <div class="fatex-u-pos-relative">
                            
                            
                            <div class="fatex-row-main">
                                <textarea class="fatex-text-input aspect-name" 
                                          placeholder="{{localize 'FAx.Global.AspectName'}}"
                                          data-id="{{this.id}}" 
                                          data-field="name"
                                          rows="1">{{this.name}}</textarea>
                            </div>

                            
                            <div class="aspect-tags-list">
                                {{#each this.displayTags}}
                                <span class="aspect-tag-pill" draggable="true" data-id="{{../id}}" data-tag-id="{{this.id}}" style="background-color: {{this.color}}" title="{{localize 'FAx.Global.RemoveTag'}}">
                                    {{this.label}}
                                    <i class="fas fa-times aspect-tag-remove" data-id="{{../id}}" data-tag-id="{{this.id}}"></i>
                                </span>
                                {{/each}}
                                <button type="button" class="add-tag-to-aspect" data-id="{{this.id}}" title="{{localize 'FAx.Global.AddTag'}}"><i class="fas fa-plus"></i></button>
                            </div>

                            
                            <div class="fatex-row-details">
                                <div class="aspect-invokes-wrapper">
                                    <label class="fatex-text-input__label">{{localize "FAx.Global.Invokes"}}</label>
                                    <div class="invoke-counter" data-id="{{this.id}}" data-field="invokes">
                                        <i class="fas fa-minus invoke-control" data-action="decrease" data-field="invokes" data-id="{{this.id}}" title="{{localize 'FAx.Global.DecreaseInvokes'}}"></i>
                                        <span class="invoke-value">{{this.invokes}}</span>
                                        <i class="fas fa-plus invoke-control" data-action="increase" data-field="invokes" data-id="{{this.id}}" title="{{localize 'FAx.Global.IncreaseInvokes'}}"></i>
                                    </div>
                                </div>

                                <div class="aspect-invokes-wrapper">
                                    <label class="fatex-text-input__label">{{localize "FAx.Global.HostileInvokes"}}</label>
                                    <div class="invoke-counter hostile" data-id="{{this.id}}" data-field="hostileInvokes">
                                        <i class="fas fa-minus invoke-control" data-action="decrease" data-field="hostileInvokes" data-id="{{this.id}}" title="{{localize 'FAx.Global.DecreaseInvokes'}}"></i>
                                        <span class="invoke-value">{{#if this.hostileInvokes}}{{this.hostileInvokes}}{{else}}0{{/if}}</span>
                                        <i class="fas fa-plus invoke-control" data-action="increase" data-field="hostileInvokes" data-id="{{this.id}}" title="{{localize 'FAx.Global.IncreaseInvokes'}}"></i>
                                    </div>
                                </div>

                                <div class="aspect-actions-wrapper">
                                <div class="aspect-item-actions">
                                    {{#if isGM}}
                                    <i class="fas {{#if this.hidden}}fa-eye-slash{{else}}fa-eye{{/if}} aspect-visibility" data-id="{{this.id}}" title="{{localize 'FAx.Global.ToggleVisibility'}}"></i>
                                    {{/if}}
                                    <i class="fas fa-trash aspect-delete" data-id="{{this.id}}" title="{{localize 'FAx.Global.DeleteAspectTitle'}}"></i>
                                </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>
        {{else if waitingForGM}}
            <div class="fatex-empty-state">
                <i class="fas fa-hourglass-half"></i>
                <p>{{localize 'FAx.Global.WaitingForGM'}}</p>
            </div>
        {{else}}
            <div class="fatex-empty-state">
                <i class="fas fa-book-open"></i>
                <p>{{localize 'FAx.Global.NoAspects'}}</p>
                {{#if isGM}}
                <button type="button" class="create-aspect" data-group-id="default"><i class="fas fa-plus"></i> {{localize 'FAx.Global.Add'}}</button>
                <small>{{localize 'FAx.Global.DragToScene'}}</small>
                {{/if}}
            </div>
        {{/if}}
    </div>
</form>